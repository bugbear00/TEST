# ─────────────────────────────────────────────────────────────
# 한국어 금융 터미널 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  cp .env.example .env
# 키가 없어도 서버는 동작하며, 키가 필요한 기능은 "API 키 필요"로 표시됩니다.
# ─────────────────────────────────────────────────────────────

# 서버 포트 (기본 3100)
PORT=3100

# [선택, 강력 권장] SEC EDGAR 접근용 User-Agent.
# SEC는 식별 가능한 이름과 이메일을 요구합니다. 미설정 시 403 오류가 날 수 있습니다.
SEC_USER_AGENT="MyName myemail@example.com"

# [선택] 미국 금리/거시지표 (FRED). 미설정 시 Yahoo 국채수익률 지수로 대체 표기.
# 발급: https://fred.stlouisfed.org/docs/api/api_key.html  (무료)
FRED_API_KEY=

# [선택] 한국 전자공시 (OpenDART). 미설정 시 DART 섹션은 "API 키 필요"로 표시.
# 발급: https://opendart.fss.or.kr/  (무료)
DART_API_KEY=

# [선택] 실적/뉴스 보강 (Finnhub). 미설정 시 Yahoo 기반 대체.
# 발급: https://finnhub.io/  (무료 티어)
FINNHUB_API_KEY=

# 외부 요청 타임아웃 (ms) / 캐시 TTL (초)
FETCH_TIMEOUT_MS=8000
CACHE_TTL_SECONDS=20
