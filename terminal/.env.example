# US 터미널 환경변수 예시. 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# 키가 없는 기능은 화면에서 "API 필요" 로 표시되며, 가짜 데이터로 채우지 않습니다.

# 서버 포트 (배포 플랫폼이 자동 주입하기도 함)
PORT=3000

# SEC EDGAR 가 요구하는 식별용 User-Agent (이름/연락처 권장)
CONTACT_USER_AGENT="US-Terminal/1.0 (your-email@example.com)"

# 미국 금리(국채 수익률) - FRED. 무료 발급: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# 종목 뉴스 / 실적 캘린더 - Finnhub. 무료 발급: https://finnhub.io/register
FINNHUB_API_KEY=

# 한국 전자공시 - DART. 무료 발급: https://opendart.fss.or.kr/ (오픈API > 인증키 신청)
DART_API_KEY=

# 옵션 체인 (선택) - Polygon.io. https://polygon.io/
POLYGON_API_KEY=

# 보조 시세 (선택) - Alpha Vantage. https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
